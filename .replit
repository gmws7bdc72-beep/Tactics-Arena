modules = ["nodejs-24"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 3000

[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 5174
externalPort = 4200

[[ports]]
localPort = 5175
externalPort = 5000

[[ports]]
localPort = 5176
externalPort = 6000

[[ports]]
localPort = 5177
externalPort = 3000

[[ports]]
localPort = 5178
externalPort = 6800

[[ports]]
localPort = 5179
externalPort = 8000

[[ports]]
localPort = 5180
externalPort = 8008

[[ports]]
localPort = 5181
externalPort = 8099

[[ports]]
localPort = 5182
externalPort = 9000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 24785
externalPort = 80

[[ports]]
localPort = 24786
externalPort = 3001

[[ports]]
localPort = 24787
externalPort = 3002

[[ports]]
localPort = 24788
externalPort = 3003

[nix]
packages = ["zip"]

[deployment]
deploymentTarget = "autoscale"
build = ["bash", "-lc", "cd artifacts/fta-game && pnpm build"]
run = ["bash", "-lc", "cd artifacts/fta-game && pnpm start"]
